PORT=3100
LOG_LEVEL=info
NODE_ENV=development
API_KEY=ai-converter-secret-key-123

# Redis (required for the async job queue — BullMQ)
REDIS_URL=redis://localhost:6379

# Extraction safety net (optional — defaults shown)
# Max time a job may run before being aborted (default: 1 hour)
EXTRACT_JOB_TIMEOUT_MS=3600000
# Base collection budget per page (default: 120s, auto-scales with length)
EXTRACT_COLLECT_TIMEOUT_MS=120000
# Ceiling for the auto-scaled collection budget (default: 50 min)
EXTRACT_COLLECT_MAX_TIMEOUT_MS=3000000
